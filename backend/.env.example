# Server
PORT=5001
NODE_ENV=development

# Database (SQLite for local dev, swap to postgres://... for prod)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="verdant-studio-secret-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# CORS — must match your frontend dev server origin
CORS_ORIGIN="http://localhost:3000"

# Base URL of THIS server (used to build absolute asset URLs)
APP_URL="http://localhost:5001"

# Upload directory (absolute path). Defaults to <backend>/uploads if unset.
# UPLOADS_DIR="/var/www/verdant/uploads"

# Max upload file size in bytes (default 5 MB)
MAX_UPLOAD_BYTES=5242880

# Google Gemini API Key (optional — editorial fallback used if absent)
GEMINI_API_KEY=""
