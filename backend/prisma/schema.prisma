generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("user") // "user" | "admin"
  plan         String   @default("Studio Pro")
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sites    Site[]
  domains  CustomDomain[]
  assets   Asset[]
}

// ─── Templates ───────────────────────────────────────────────────────────────

model Template {
  id            String   @id          // e.g. "boutique-chic"
  name          String   @unique
  category      String
  description   String
  popularity    String
  palette       String               // JSON: string[]
  defaultConfig String               // JSON: SiteConfig — the full starter config
  previewImageUrl String  @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sites Site[]
}

// ─── Sites ───────────────────────────────────────────────────────────────────

model Site {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  String?
  template    Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  name        String
  slug        String   @unique        // URL-safe slug, e.g. "aurelia-boutique"
  status      String   @default("draft") // "draft" | "published"
  publishedAt DateTime?

  // The two sides of draft/publish:
  draftConfig     String             // JSON: SiteConfig
  publishedConfig String  @default("{}") // JSON: SiteConfig (copy of draft at last publish)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products  Product[]
  versions  SiteVersion[]
  domains   CustomDomain[]
  assets    Asset[]

  // E-Commerce
  storeSettings StoreSettings?
  customers     Customer[]
  orders        Order[]
  coupons       Coupon[]
  inquiries     Inquiry[]
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id            String   @id @default(cuid())
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  name          String
  description   String   @default("")
  price         Float
  discountPrice Float?
  category      String   @default("General")
  stockQty      Int      @default(0)
  status        String   @default("active") // "active" | "hidden"
  images        String   @default("[]")     // JSON: ProductImage[]
  sortOrder     Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems    OrderItem[]
  cartItems     CartItem[]
}

// ─── Site Version History ────────────────────────────────────────────────────

model SiteVersion {
  id             String   @id @default(cuid())
  siteId         String
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  label          String   @default("") // e.g. "Auto-saved" or "Before template switch"
  configSnapshot String               // JSON: SiteConfig snapshot
  createdAt      DateTime @default(now())
}

// ─── Assets ──────────────────────────────────────────────────────────────────

model Asset {
  id        String   @id @default(cuid())
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  filename  String   @unique
  url       String
  mimeType  String
  sizeBytes Int

  createdAt DateTime @default(now())
}

// ─── Custom Domains ───────────────────────────────────────────────────────────

model CustomDomain {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  domain    String   @unique
  status    String   @default("dns_active")
  dnsTarget String   @default("76.76.21.21")
  sslStatus String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── E-Commerce ───────────────────────────────────────────────────────────────

model StoreSettings {
  id                String   @id @default(cuid())
  siteId            String   @unique
  site              Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  currency          String   @default("USD")
  shippingRate      Float    @default(0.0)
  freeShippingMin   Float?
  taxRate           Float    @default(0.0)
  
  codEnabled        Boolean  @default(true)
  razorpayEnabled   Boolean  @default(false)
  razorpayKeyId     String?
  razorpayKeySecret String?  // encrypted

  stripeEnabled     Boolean  @default(false)
  stripeKeyId       String?
  stripeKeySecret   String?  // encrypted

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Customer {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
  email        String
  passwordHash String
  name         String
  phone        String?
  
  addresses    Address[]
  orders       Order[]
  cartItems    CartItem[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([siteId, email])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  isDefault  Boolean  @default(false)
  fullName   String
  line1      String
  line2      String?
  city       String
  state      String
  pin        String
  country    String   @default("US")
  phone      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CartItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId])
}

model Order {
  id               String   @id @default(cuid())
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  orderNumber      String   @unique
  status           String   @default("pending") // pending, paid, processing, shipped, delivered, cancelled, refunded
  
  paymentMethod    String   @default("COD") // COD, Razorpay, Stripe
  paymentStatus    String   @default("pending") // pending, success, failed
  paymentIntentId  String?  // Razorpay order ID or Stripe intent
  
  subtotal         Float
  shipping         Float    @default(0.0)
  tax              Float    @default(0.0)
  discount         Float    @default(0.0)
  total            Float
  
  shippingAddress  String   // JSON snapshot of the address
  contactEmail     String
  contactPhone     String?
  
  trackingNumber   String?

  items            OrderItem[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  productName     String   // Snapshot of name
  sku             String?
  priceAtPurchase Float
  quantity        Int
}

model Coupon {
  id            String   @id @default(cuid())
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  code          String
  discountType  String
  discountValue Float
  minPurchase   Float?
  maxUsage      Int?
  usedCount     Int      @default(0)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  @@unique([siteId, code])
}

model Inquiry {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  metadata  String?
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model PricingPlan {
  id           String   @id @default(cuid())
  name         String   @unique
  tagline      String
  monthlyPrice Float
  yearlyPrice  Float
  isPopular    Boolean  @default(false)
  features     String
  cta          String
  ctaHref      String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
